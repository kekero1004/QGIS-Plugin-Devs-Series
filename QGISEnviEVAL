# Chapter 14. SiteSurveyor 통합 — 플러그인 본체와 Task 연결

```python
# plugin.py (발췌)
from qgis.PyQt.QtCore import Qt
from qgis.core import (QgsApplication, QgsTask, QgsProject,
                       QgsCoordinateReferenceSystem)
from .gui.dock_widget import SurveyDockWidget
from .core import survey_engine
from .core.models import SurveyItem
from .core.report_builder import result_to_table
from .processing.provider import EngineeringProvider


class _SurveyTask(QgsTask):
    def __init__(self, site_geom, work_crs, radii, items, on_done):
        super().__init__("기초조사 실행", QgsTask.CanCancel)
        self.args = (site_geom, work_crs, radii, items)
        self.on_done = on_done
        self.result = None
        self.exception = None

    def run(self):
        try:
            self.result = survey_engine.run_survey(
                *self.args,
                progress=self.setProgress,
                is_canceled=self.isCanceled)
            return not self.isCanceled()
        except Exception as e:
            self.exception = e
            return False

    def finished(self, ok):
        self.on_done(ok, self.result, self.exception)


class SiteSurveyorPlugin:

    def __init__(self, iface):
        self.iface = iface
        self.dock = None
        self.provider = None
        self._task = None            # ★ 참조 유지 필수

    def initGui(self):
        self.provider = EngineeringProvider()
        QgsApplication.processingRegistry().addProvider(self.provider)

        self.dock = SurveyDockWidget(self.iface)
        self.dock.btn_run.clicked.connect(self.start_survey)
        self.iface.addDockWidget(
            Qt.DockWidgetArea.RightDockWidgetArea, self.dock)

    def unload(self):
        if self.provider:
            QgsApplication.processingRegistry().removeProvider(self.provider)
        if self.dock:
            self.iface.removeDockWidget(self.dock)
            self.dock.deleteLater()

    def start_survey(self):
        site_layer = self.dock.cbo_site.currentLayer()
        if site_layer is None or site_layer.featureCount() == 0:
            self.iface.messageBar().pushWarning("기초조사", "사업지 레이어를 선택하세요.")
            return

        # 사업지 병합 지오메트리
        geoms = [f.geometry() for f in site_layer.getFeatures()]
        site_geom = geoms[0]
        for g in geoms[1:]:
            site_geom = site_geom.combine(g)

        work_crs = site_layer.crs()
        if work_crs.isGeographic():
            work_crs = QgsCoordinateReferenceSystem("EPSG:5186")
            self.iface.messageBar().pushInfo(
                "기초조사", "지리좌표계 입력 → EPSG:5186으로 변환하여 집계합니다.")
            # 실무에서는 사업지 경도 기반 원점 자동 선택 로직을 넣는다 (연습문제)

        items = self.dock.collect_items()   # 사용자가 등록한 SurveyItem 목록
        radii = self.dock.collect_radii()   # 예: [300, 500, 1000]

        self.dock.progress.setVisible(True)
        self._task = _SurveyTask(site_geom, work_crs, radii, items,
                                 self.on_survey_done)
        self._task.progressChanged.connect(
            lambda p: self.dock.progress.setValue(int(p)))
        QgsApplication.taskManager().addTask(self._task)

    def on_survey_done(self, ok, result, exc):
        self.dock.progress.setVisible(False)
        if not ok:
            msg = f"조사 실패: {exc}" if exc else "사용자 취소"
            self.iface.messageBar().pushCritical("기초조사", msg)
            return
        head, rows = result_to_table(result)
        self.dock.show_result_table(head, rows)
        for w in result.warnings:
            self.dock.txt_log.append("⚠ " + w)
        self.iface.messageBar().pushSuccess(
            "기초조사", f"완료 — 집계 {len(rows)}건")
```

> **WARNING** — `self._task`처럼 Task 참조를 멤버로 보관하지 않으면
> 가비지 컬렉션으로 Task가 도중에 사라지는 고전적 버그가 발생한다.


# Chapter 21. 지형영향 분석 — 경사 · 표고 · 절성토 개산

도로·철도 사업의 환경 검토에는 지형훼손 규모 개산이 함께 요구된다.

```python
# core/terrain_engine.py
import processing
from qgis.core import QgsApplication, QgsRasterLayer


def _find_alg(*cands):
    reg = QgsApplication.processingRegistry()
    for a in cands:
        if reg.algorithmById(a):
            return a
    raise RuntimeError("알고리즘 없음: " + ", ".join(cands))


def clip_dem(dem_layer, mask_layer):
    alg = _find_alg("gdal:cliprasterbymasklayer")
    return processing.run(alg, {
        "INPUT": dem_layer, "MASK": mask_layer,
        "CROP_TO_CUTLINE": True, "KEEP_RESOLUTION": True,
        "OUTPUT": "TEMPORARY_OUTPUT"})["OUTPUT"]


def slope_stats(dem_path_or_layer):
    """사업지 DEM의 경사 통계: (평균, 최대, 급경사(≥25°) 비율%)"""
    slope_alg = _find_alg("native:slope", "qgis:slope", "gdal:slope")
    slope = processing.run(slope_alg, {
        "INPUT": dem_path_or_layer, "Z_FACTOR": 1.0,
        "OUTPUT": "TEMPORARY_OUTPUT"})["OUTPUT"]

    rl = QgsRasterLayer(slope, "slope")
    st = rl.dataProvider().bandStatistics(1)

    # 급경사 비율: 재분류 후 unique count (버전 호환을 위해 히스토그램 대신)
    reclass = _find_alg("native:reclassifybytable", "qgis:reclassifybytable")
    steep = processing.run(reclass, {
        "INPUT_RASTER": slope, "RASTER_BAND": 1,
        "TABLE": ["0", "25", "0", "25", "90", "1"],
        "RANGE_BOUNDARIES": 0, "NODATA_FOR_MISSING": True, "NO_DATA": -9999,
        "OUTPUT": "TEMPORARY_OUTPUT"})["OUTPUT"]
    srl = QgsRasterLayer(steep, "steep")
    sstat = srl.dataProvider().bandStatistics(1)
    steep_pct = sstat.mean * 100.0 if sstat.mean is not None else 0.0

    return {"mean_deg": st.mean, "max_deg": st.maximumValue,
            "steep_pct": steep_pct}


def elevation_stats(dem_path_or_layer):
    rl = (dem_path_or_layer if isinstance(dem_path_or_layer, QgsRasterLayer)
          else QgsRasterLayer(dem_path_or_layer, "dem"))
    st = rl.dataProvider().bandStatistics(1)
    return {"min_m": st.minimumValue, "max_m": st.maximumValue,
            "mean_m": st.mean}


def cut_fill_estimate(dem_layer, site_mask, plan_elev_m):
    """계획고 대비 절·성토량 개산 (단순 평면 계획고 모델).
    반환: (절토량 m3, 성토량 m3) — 개산치임을 보고서에 명기."""
    clipped = clip_dem(dem_layer, site_mask)
    rl = QgsRasterLayer(clipped, "dem_site")
    cell = rl.rasterUnitsPerPixelX() * rl.rasterUnitsPerPixelY()

    calc = _find_alg("qgis:rastercalculator", "native:rastercalc")
    # 절토: max(지반고-계획고, 0), 성토: max(계획고-지반고, 0)
    cut = processing.run(calc, {
        "EXPRESSION": f'("dem_site@1" > {plan_elev_m}) '
                      f'* ("dem_site@1" - {plan_elev_m})',
        "LAYERS": [rl], "OUTPUT": "TEMPORARY_OUTPUT"})["OUTPUT"]
    fill = processing.run(calc, {
        "EXPRESSION": f'("dem_site@1" < {plan_elev_m}) '
                      f'* ({plan_elev_m} - "dem_site@1")',
        "LAYERS": [rl], "OUTPUT": "TEMPORARY_OUTPUT"})["OUTPUT"]

    def volume(path):
        r = QgsRasterLayer(path, "v")
        st = r.dataProvider().bandStatistics(1)
        # mean × 유효셀수 × 셀면적 = 합계 × 셀면적
        return (st.sum if hasattr(st, "sum") and st.sum
                else st.mean * st.elementCount) * cell

    return volume(cut), volume(fill)
```

> **호환성 메모** — `QgsRasterBandStats.sum` 속성 가용 여부는 버전에 따라
> 다를 수 있어 `mean × elementCount` 폴백을 함께 둔다. 이런 "속성 존재 확인 후
> 폴백" 패턴은 3.6~4.x 호환의 실전 기법이다.


def build_report_html(title, meta_rows, table_head, table_rows):
    def tr_meta(k, v):
        return f"<tr><th style='width:160px'>{k}</th><td>{v}</td></tr>"

    head_html = "".join(f"<th>{h}</th>" for h in table_head)
    body_html = ""
    for row in table_rows:

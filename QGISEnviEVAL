# core/eia_report.py
from .eia_engine import EiaResult


def result_to_table(result: EiaResult):
    head = ["검토항목", "구분", "건수", "중첩면적(m²)",
            "사업지대비(%)", "최단거리(m)", "판정", "비고"]
    rows = []
    for f in result.findings:

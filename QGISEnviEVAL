## 12.2 분석 엔진 (`core/survey_engine.py`)

```python
"""기초조사 엔진 — GUI 비의존, QgsTask.run()에서 호출 가능."""
from typing import Callable, List, Optional
from qgis.core import (QgsVectorLayer, QgsGeometry, QgsFeatureRequest,
                       QgsCoordinateReferenceSystem, QgsCoordinateTransform,
                       QgsProject)
from .models import SurveyItem, SurveyRow, SurveyResult


def build_rings(site_geom: QgsGeometry, radii: List[float]):
    """다중 반경 도넛(링) 생성. radii 예: [300, 500, 1000]"""
    rings = []
    prev = site_geom
    prev_label = 0
    for r in sorted(radii):
        buf = site_geom.buffer(r, 24)
        ring = buf.difference(prev)
        rings.append((f"{prev_label}~{int(r)}m", ring))
        prev, prev_label = buf, int(r)
    # 사업지 자체(0m, 직접편입)를 맨 앞에
    rings.insert(0, ("직접편입", site_geom))
    return rings


def _reproject(geom: QgsGeometry, src: QgsCoordinateReferenceSystem,
               dst: QgsCoordinateReferenceSystem) -> QgsGeometry:
    if src == dst:
        return geom
    tr = QgsCoordinateTransform(src, dst, QgsProject.instance())
    g = QgsGeometry(geom)
    g.transform(tr)
    return g


def analyze_item(item: SurveyItem,
                 rings,
                 work_crs: QgsCoordinateReferenceSystem,
                 is_canceled: Callable[[], bool] = lambda: False
                 ) -> List[SurveyRow]:
    """레이어 1건 × 링 전체 집계."""
    layer = QgsVectorLayer(item.layer_source, item.name, item.provider)
    if not layer.isValid():
        raise RuntimeError(f"레이어 열기 실패: {item.name}")

    rows = {}
    for ring_label, ring_geom in rings:
        # 링 지오메트리를 레이어 CRS로 변환하여 BBox 필터
        ring_in_layer = _reproject(ring_geom, work_crs, layer.crs())

        req = QgsFeatureRequest().setFilterRect(ring_in_layer.boundingBox())
        if item.group_field:
            req.setSubsetOfAttributes([item.group_field], layer.fields())
        else:
            req.setSubsetOfAttributes([])

        for f in layer.getFeatures(req):
            if is_canceled():
                return []
            fg = f.geometry()
            if fg is None or fg.isEmpty():
                continue
            if not fg.intersects(ring_in_layer):
                continue

            inter = fg.intersection(ring_in_layer)
            if inter.isEmpty():
                continue

            # 측정은 작업좌표계(투영)에서
            inter_w = _reproject(inter, layer.crs(), work_crs)
            if item.geom_kind == "polygon":
                measure = inter_w.area()
            elif item.geom_kind == "line":
                measure = inter_w.length()
            else:
                measure = 0.0

            cat = str(f[item.group_field]) if item.group_field else "전체"
            key = (ring_label, cat)
            if key not in rows:
                rows[key] = SurveyRow(item.name, ring_label, cat, 0, 0.0)
            rows[key].count += 1
            rows[key].measure += measure

    return sorted(rows.values(),
                  key=lambda r: (r.ring_label, -r.measure))


def run_survey(site_geom: QgsGeometry,
               work_crs: QgsCoordinateReferenceSystem,
               radii: List[float],
               items: List[SurveyItem],
               progress: Callable[[float], None] = lambda p: None,
               is_canceled: Callable[[], bool] = lambda: False
               ) -> SurveyResult:
    result = SurveyResult(site_area_m2=site_geom.area())
    rings = build_rings(site_geom, radii)
    n = max(len(items), 1)
    for i, item in enumerate(items):
        if is_canceled():
            break
        try:
            result.rows.extend(analyze_item(item, rings, work_crs, is_canceled))
        except Exception as e:
            result.warnings.append(f"{item.name}: {e}")
        progress(100.0 * (i + 1) / n)
    return result
```

이 엔진의 설계 포인트:

1. **레이어를 소스 문자열로 받아 스레드 안에서 재오픈** — 스레드 안전
2. **BBox 필터 → 정밀 intersects → intersection** 3단계 — 대용량 성능
3. **측정은 작업 투영좌표계에서** — 면적·연장 정확도
4. `progress` / `is_canceled` 콜백 주입 — QgsTask · Processing feedback 양쪽 호환

## 13.1 집계표 → 보고서

```python
# core/report_builder.py
from .models import SurveyResult
from collections import defaultdict


def result_to_table(result: SurveyResult):
    head = ["레이어", "구간", "분류", "건수", "면적/연장"]
    rows = []
    for r in result.rows:
        rows.append([r.layer_name, r.ring_label, r.category,
                     r.count, round(r.measure, 1)])
    return head, rows


def summarize_by_layer(result: SurveyResult):
    agg = defaultdict(lambda: [0, 0.0])
    for r in result.rows:
        agg[r.layer_name][0] += r.count
        agg[r.layer_name][1] += r.measure
    return agg
```


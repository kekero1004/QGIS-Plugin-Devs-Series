    layer_source: str         # 소스 문자열 (스레드에서 재오픈)
    provider: str             # "ogr" 등
    group_field: Optional[str]  # 분류 필드 (예: "지목") — 없으면 전체 집계
    geom_kind: str            # "polygon" | "line" | "point"


@dataclass
class SurveyRow:
    layer_name: str
    ring_label: str           # "0~300m" 등
    category: str             # 분류값 (지목 등)
    count: int
    measure: float            # 면적(m2) 또는 연장(m), 점이면 0


@dataclass
class SurveyResult:
    site_area_m2: float
    rows: List[SurveyRow] = field(default_factory=list)
    warnings: List[str] = field(default_factory=list)

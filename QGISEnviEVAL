## 22.1 결과 시각화 — 저촉 지역 하이라이트 레이어

`finished()`(메인 스레드)에서 triggered 항목의 중첩 지오메트리를
메모리 레이어로 만들어 캔버스에 표시한다.

```python
from qgis.core import (QgsVectorLayer, QgsFeature, QgsProject,
                       QgsFillSymbol)
from .compat import make_field, TYPE_STRING, TYPE_DOUBLE


def make_conflict_layer(findings_geoms, crs):
    """findings_geoms: [(항목명, QgsGeometry, 면적), ...]"""
    vl = QgsVectorLayer(f"Polygon?crs={crs.authid()}", "환경저촉현황", "memory")
    pr = vl.dataProvider()
    pr.addAttributes([make_field("항목", TYPE_STRING, 60),
                      make_field("면적_m2", TYPE_DOUBLE, 20, 1)])
    vl.updateFields()

    feats = []
    for name, geom, area in findings_geoms:
        f = QgsFeature(vl.fields())
        f.setGeometry(geom)
        f.setAttributes([name, area])
        feats.append(f)
    pr.addFeatures(feats)

    sym = QgsFillSymbol.createSimple({
        "color": "227,74,51,120", "outline_color": "178,24,43",
        "outline_width": "0.6"})
    vl.renderer().setSymbol(sym)
    QgsProject.instance().addMapLayer(vl)
    return vl
```


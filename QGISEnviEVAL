# Chapter 20. 스크리닝 엔진 전체 코드

```python
# core/eia_engine.py
"""환경영향 스크리닝 엔진 — GUI 비의존."""
from dataclasses import dataclass, field
from typing import List, Optional, Callable
import json

from qgis.core import (QgsVectorLayer, QgsGeometry, QgsFeatureRequest,
                       QgsCoordinateReferenceSystem, QgsCoordinateTransform,
                       QgsProject)


@dataclass
class EiaCheck:
    id: str
    name: str
    layer_source: str
    provider: str
    subset_filter: Optional[str]      # QGIS 표현식/SQL where
    mode: str                         # "overlap" | "proximity"
    threshold_value: float
    note: str = ""


@dataclass
class EiaFinding:
    check_id: str
    check_name: str
    mode: str
    overlap_area_m2: float = 0.0
    overlap_pct: float = 0.0          # 사업지 면적 대비
    min_distance_m: Optional[float] = None
    hit_count: int = 0
    triggered: bool = False           # 임계값 초과 여부
    note: str = ""


@dataclass
class EiaResult:
    site_area_m2: float
    findings: List[EiaFinding] = field(default_factory=list)
    warnings: List[str] = field(default_factory=list)

    @property
    def triggered_count(self):
        return sum(1 for f in self.findings if f.triggered)


def _to_layer_crs(geom, work_crs, layer):
    if work_crs == layer.crs():
        return QgsGeometry(geom)
    tr = QgsCoordinateTransform(work_crs, layer.crs(), QgsProject.instance())
    g = QgsGeometry(geom)
    g.transform(tr)
    return g


def _to_work_crs(geom, layer, work_crs):
    if work_crs == layer.crs():
        return QgsGeometry(geom)
    tr = QgsCoordinateTransform(layer.crs(), work_crs, QgsProject.instance())
    g = QgsGeometry(geom)
    g.transform(tr)
    return g


def run_check(check: EiaCheck,
              site_geom: QgsGeometry,
              work_crs: QgsCoordinateReferenceSystem,
              search_radius_m: float,
              is_canceled: Callable[[], bool] = lambda: False) -> EiaFinding:

    layer = QgsVectorLayer(check.layer_source, check.name, check.provider)
    if not layer.isValid():
        raise RuntimeError(f"레이어 열기 실패: {check.name}")

    finding = EiaFinding(check.id, check.name, check.mode, note=check.note)
    site_area = site_geom.area()

    # 검색범위: 근접검사는 max(임계, 검색반경) 버퍼 BBox
    search_r = search_radius_m
    if check.mode == "proximity":
        search_r = max(search_r, check.threshold_value)
    search_geom = site_geom.buffer(search_r, 16)
    search_in_layer = _to_layer_crs(search_geom, work_crs, layer)

    req = QgsFeatureRequest().setFilterRect(search_in_layer.boundingBox())
    if check.subset_filter:
        req.setFilterExpression(check.subset_filter)
    req.setSubsetOfAttributes([])

    min_dist = None
    for f in layer.getFeatures(req):
        if is_canceled():
            break
        fg = f.geometry()
        if fg is None or fg.isEmpty():
            continue

        fg_work = _to_work_crs(fg, layer, work_crs)

        if check.mode == "overlap":
            if fg_work.intersects(site_geom):
                inter = fg_work.intersection(site_geom)
                if not inter.isEmpty():
                    finding.overlap_area_m2 += inter.area()
                    finding.hit_count += 1
        else:  # proximity
            d = fg_work.distance(site_geom)
            if min_dist is None or d < min_dist:
                min_dist = d
            finding.hit_count += 1

    if check.mode == "overlap":
        finding.overlap_pct = (100.0 * finding.overlap_area_m2 / site_area
                               if site_area > 0 else 0.0)
        finding.triggered = finding.overlap_area_m2 > check.threshold_value
    else:
        finding.min_distance_m = min_dist
        finding.triggered = (min_dist is not None
                             and min_dist <= check.threshold_value)
    return finding


def run_screening(checks: List[EiaCheck],
                  site_geom: QgsGeometry,
                  work_crs: QgsCoordinateReferenceSystem,
                  search_radius_m: float = 2000.0,
                  progress: Callable[[float], None] = lambda p: None,
                  is_canceled: Callable[[], bool] = lambda: False) -> EiaResult:
    result = EiaResult(site_area_m2=site_geom.area())
    n = max(len(checks), 1)
    for i, c in enumerate(checks):
        if is_canceled():
            break
        try:
            result.findings.append(
                run_check(c, site_geom, work_crs, search_radius_m, is_canceled))
        except Exception as e:
            result.warnings.append(f"{c.name}: {e}")
        progress(100.0 * (i + 1) / n)
    return result


def load_checks_config(path, layer_bindings):
    """JSON 설정 + {layer_hint: (source, provider)} 매핑 → EiaCheck 목록."""
    with open(path, encoding="utf-8") as fp:
        cfg = json.load(fp)
    checks = []
    for c in cfg["checks"]:
        hint = c["layer_hint"]
        if hint not in layer_bindings:
            continue  # UI에서 미연결 항목은 경고 표시
        src, prov = layer_bindings[hint]
        checks.append(EiaCheck(
            id=c["id"], name=c["name"],
            layer_source=src, provider=prov,
            subset_filter=c.get("filter"),
            mode=c["mode"],
            threshold_value=float(c["threshold"]["value"]),
            note=c.get("note", "")))
    return checks

    item_map.attemptMove(QgsLayoutPoint(10, 25, QgsUnitTypes.LayoutMillimeters))
    item_map.attemptResize(QgsLayoutSize(277, 165, QgsUnitTypes.LayoutMillimeters))
    item_map.setExtent(extent)
    layout.addLayoutItem(item_map)

    label = QgsLayoutItemLabel(layout)
    label.setText(title)
    label.adjustSizeToText()
    label.attemptMove(QgsLayoutPoint(10, 8, QgsUnitTypes.LayoutMillimeters))
    layout.addLayoutItem(label)

    exporter = QgsLayoutExporter(layout)
    exporter.exportToPdf(out_pdf, QgsLayoutExporter.PdfExportSettings())

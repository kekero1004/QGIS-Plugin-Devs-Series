# Chapter 23. EIA Screener — Processing Algorithm 노출

배치 실행(대안 여러 개 스크리닝)을 위해 엔진을 알고리즘으로도 감싼다.

```python
# processing/eia_screening.py (발췌)
from qgis.PyQt.QtCore import QCoreApplication
from qgis.core import (QgsProcessingAlgorithm, QgsProcessing,
                       QgsProcessingParameterFeatureSource,
                       QgsProcessingParameterFile,
                       QgsProcessingParameterNumber,
                       QgsProcessingParameterFileDestination,
                       QgsProcessingException)
from ..core import eia_engine
from ..core.eia_report import result_to_table, summary_sentence
from ..core.report_builder_bridge import build_report_html  # Ch.10 재사용


class EiaScreeningAlgorithm(QgsProcessingAlgorithm):
    SITE = "SITE"
    CONFIG = "CONFIG"
    RADIUS = "RADIUS"
    REPORT = "REPORT"

    def tr(self, s):
        return QCoreApplication.translate("EiaScreening", s)

    def createInstance(self):
        return EiaScreeningAlgorithm()

    def name(self):
        return "eiascreening"

    def displayName(self):
        return self.tr("환경영향 스크리닝")

    def group(self):
        return self.tr("환경영향성 평가")

    def groupId(self):
        return "eia"

    def initAlgorithm(self, config=None):
        self.addParameter(QgsProcessingParameterFeatureSource(
            self.SITE, self.tr("사업지 경계"),
            [QgsProcessing.TypeVectorPolygon]))
        self.addParameter(QgsProcessingParameterFile(
            self.CONFIG, self.tr("검토항목 설정(JSON)"),
            extension="json"))
        self.addParameter(QgsProcessingParameterNumber(
            self.RADIUS, self.tr("탐색반경 (m)"),
            QgsProcessingParameterNumber.Double, 2000.0))
        self.addParameter(QgsProcessingParameterFileDestination(
            self.REPORT, self.tr("보고서(HTML)"),
            self.tr("HTML 파일 (*.html)")))

    def processAlgorithm(self, parameters, context, feedback):
        source = self.parameterAsSource(parameters, self.SITE, context)
        cfg_path = self.parameterAsFile(parameters, self.CONFIG, context)
        radius = self.parameterAsDouble(parameters, self.RADIUS, context)
        out_html = self.parameterAsFileOutput(parameters, self.REPORT, context)

        # 사업지 병합
        geoms = [f.geometry() for f in source.getFeatures()]
        if not geoms:
            raise QgsProcessingException(self.tr("사업지 피처가 없습니다."))
        site = geoms[0]
        for g in geoms[1:]:
            site = site.combine(g)

        work_crs = source.sourceCrs()
        if work_crs.isGeographic():
            raise QgsProcessingException(
                self.tr("투영좌표계(EPSG:5186 등) 사업지를 입력하세요."))

        # 설정의 layer_hint를 프로젝트 레이어 이름과 자동 매칭 (연습문제로 개선)
        from qgis.core import QgsProject
        bindings = {}
        for lyr in QgsProject.instance().mapLayers().values():
            bindings[lyr.name()] = (lyr.source(), lyr.providerType())

        checks = eia_engine.load_checks_config(cfg_path, bindings)
        if not checks:
            raise QgsProcessingException(
                self.tr("설정의 검토항목과 매칭되는 레이어가 없습니다."))

        result = eia_engine.run_screening(
            checks, site, work_crs, radius,
            progress=lambda p: feedback.setProgress(int(p)),
            is_canceled=feedback.isCanceled)

        head, rows = result_to_table(result)
        html = build_report_html(
            "환경영향성 스크리닝 결과",
            [("사업지 면적", f"{result.site_area_m2:,.1f} m²"),
             ("탐색반경", f"{radius:,.0f} m"),
             ("종합", summary_sentence(result))],
            head, rows)
        with open(out_html, "w", encoding="utf-8") as fp:
            fp.write(html)

        for w in result.warnings:
            feedback.pushWarning(w)
        return {self.REPORT: out_html}
```


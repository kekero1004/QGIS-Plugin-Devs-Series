            (round(f.min_distance_m, 1)
             if f.min_distance_m is not None else "-"),
            "<span class='warn'>검토필요</span>" if f.triggered else "해당없음",
            f.note,
        ])
    return head, rows


def summary_sentence(result: EiaResult):
    t = result.triggered_count
    if t == 0:
        return ("전체 검토항목에서 임계기준 초과 사항이 확인되지 않았습니다. "
                "단, 본 결과는 GIS 스크리닝 참고자료이며 법정 검토를 대체하지 않습니다.")
    return (f"총 {len(result.findings)}개 항목 중 {t}개 항목에서 "
            f"임계기준 초과가 확인되었습니다. 해당 항목에 대한 "

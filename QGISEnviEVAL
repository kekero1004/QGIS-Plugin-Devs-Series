# Chapter 16~18. SiteSelector 구현 — Processing Algorithm 전체 코드

입지선정 엔진은 배치 실행(대안 다중 평가)과 모델 디자이너 연계가 중요하므로
**Processing Algorithm으로 구현**한다.

```python
# processing/site_suitability.py
"""
가중중첩 입지 적합도 알고리즘 (QGIS 3.6~4.x)

입력:
  - 기준 래스터 N개 (동일 CRS 권장, 해상도 상이 허용 — 기준 셀로 리샘플)
  - 각 기준의 방향(편익/비용)과 가중치
  - 제약 폴리곤(배제지역, 선택)
출력:
  - 0~1 적합도 래스터
"""
from qgis.PyQt.QtCore import QCoreApplication
from qgis.core import (QgsProcessingAlgorithm, QgsProcessing,
                       QgsProcessingParameterMultipleLayers,
                       QgsProcessingParameterString,
                       QgsProcessingParameterVectorLayer,
                       QgsProcessingParameterRasterDestination,
                       QgsProcessingException,
                       QgsApplication)
import processing


def tr(s):
    return QCoreApplication.translate("SiteSuitability", s)


def find_alg(*candidates):
    reg = QgsApplication.processingRegistry()
    for a in candidates:
        if reg.algorithmById(a):
            return a
    raise QgsProcessingException(tr("알고리즘 없음: ") + ", ".join(candidates))


class SiteSuitabilityAlgorithm(QgsProcessingAlgorithm):
    CRITERIA = "CRITERIA"
    WEIGHTS = "WEIGHTS"       # "0.4,0.3,0.3" 형식
    DIRECTIONS = "DIRECTIONS" # "cost,benefit,benefit" 형식
    CONSTRAINT = "CONSTRAINT"
    OUTPUT = "OUTPUT"

    def createInstance(self):
        return SiteSuitabilityAlgorithm()

    def name(self):
        return "sitesuitability"

    def displayName(self):
        return tr("입지 적합도 (가중중첩)")

    def group(self):
        return tr("입지선정")

    def groupId(self):
        return "siteselection"

    def shortHelpString(self):
        return tr(
            "기준 래스터들을 0~1로 표준화한 뒤 가중합산하여 적합도를 계산합니다.\n"
            "WEIGHTS와 DIRECTIONS는 기준 레이어 순서와 동일한 콤마 구분 목록입니다.\n"
            "DIRECTIONS: benefit(클수록 적합) 또는 cost(작을수록 적합).\n"
            "제약 폴리곤 입력 시 해당 지역 적합도는 0이 됩니다.")

    def initAlgorithm(self, config=None):
        self.addParameter(QgsProcessingParameterMultipleLayers(
            self.CRITERIA, tr("기준 래스터 목록"),
            QgsProcessing.TypeRaster))
        self.addParameter(QgsProcessingParameterString(
            self.WEIGHTS, tr("가중치 (콤마 구분, 합=1)"), "0.5,0.5"))
        self.addParameter(QgsProcessingParameterString(
            self.DIRECTIONS, tr("방향 (benefit|cost, 콤마 구분)"),
            "benefit,benefit"))
        self.addParameter(QgsProcessingParameterVectorLayer(
            self.CONSTRAINT, tr("제약(배제) 폴리곤"),
            [QgsProcessing.TypeVectorPolygon], optional=True))
        self.addParameter(QgsProcessingParameterRasterDestination(
            self.OUTPUT, tr("적합도 래스터")))

    # ---------- 내부 유틸 ----------

    def _minmax(self, rlayer):
        """band1 min/max — 3.6 호환을 위해 provider 통계 사용."""
        stats = rlayer.dataProvider().bandStatistics(1)
        return stats.minimumValue, stats.maximumValue

    def _normalize(self, rlayer, direction, context, feedback):
        vmin, vmax = self._minmax(rlayer)
        if vmax - vmin == 0:
            raise QgsProcessingException(
                tr("상수 래스터는 표준화할 수 없습니다: ") + rlayer.name())
        calc = find_alg("qgis:rastercalculator", "native:rastercalc")
        ref = f'"{rlayer.name()}@1"'
        if direction == "benefit":
            expr = f"({ref} - {vmin}) / ({vmax} - {vmin})"
        else:
            expr = f"({vmax} - {ref}) / ({vmax} - {vmin})"
        return processing.run(calc, {
            "EXPRESSION": expr,
            "LAYERS": [rlayer],
            "OUTPUT": "TEMPORARY_OUTPUT"
        }, context=context, feedback=feedback,
           is_child_algorithm=True)["OUTPUT"]

    # ---------- 본체 ----------

    def processAlgorithm(self, parameters, context, feedback):
        rasters = self.parameterAsLayerList(parameters, self.CRITERIA, context)
        weights = [float(x) for x in
                   self.parameterAsString(parameters, self.WEIGHTS, context).split(",")]
        dirs = [x.strip().lower() for x in
                self.parameterAsString(parameters, self.DIRECTIONS, context).split(",")]
        constraint = self.parameterAsVectorLayer(parameters, self.CONSTRAINT, context)

        n = len(rasters)
        if not (len(weights) == len(dirs) == n):
            raise QgsProcessingException(
                tr("기준/가중치/방향 개수가 일치하지 않습니다."))
        if abs(sum(weights) - 1.0) > 1e-6:
            feedback.pushWarning(
                tr(f"가중치 합이 1이 아닙니다({sum(weights):.3f}) — 정규화합니다."))
            s = sum(weights)
            weights = [w / s for w in weights]
        for d in dirs:
            if d not in ("benefit", "cost"):
                raise QgsProcessingException(tr("방향은 benefit|cost: ") + d)

        # 1) 기준별 표준화
        norm_paths = []
        for i, (r, d) in enumerate(zip(rasters, dirs)):
            if feedback.isCanceled():
                return {}
            feedback.pushInfo(tr(f"[{i+1}/{n}] 표준화: {r.name()} ({d})"))
            norm_paths.append(self._normalize(r, d, context, feedback))
            feedback.setProgress(50.0 * (i + 1) / n)

        # 2) 가중합산 — 표준화 래스터를 레이어로 재로드 후 계산식 구성
        from qgis.core import QgsRasterLayer
        norm_layers = []
        for i, p in enumerate(norm_paths):
            nl = QgsRasterLayer(p, f"norm_{i}")
            if not nl.isValid():
                raise QgsProcessingException(tr("표준화 결과 로드 실패"))
            norm_layers.append(nl)

        expr = " + ".join(
            f'({w} * "norm_{i}@1")' for i, w in enumerate(weights))
        calc = find_alg("qgis:rastercalculator", "native:rastercalc")
        weighted = processing.run(calc, {
            "EXPRESSION": expr,
            "LAYERS": norm_layers,
            "OUTPUT": "TEMPORARY_OUTPUT" if constraint else
                      parameters[self.OUTPUT]
        }, context=context, feedback=feedback,
           is_child_algorithm=True)["OUTPUT"]
        feedback.setProgress(80)

        # 3) 제약 마스킹 (배제지역 → 0)
        if constraint:
            feedback.pushInfo(tr("제약지역 마스킹 적용"))
            clip_alg = find_alg("gdal:cliprasterbymasklayer")
            # 제약의 '반대' 영역으로 클리핑하는 대신,
            # 제약 래스터화(내부=0, 외부=1) 후 곱하는 방식이 견고하다.
            rasterize = find_alg("gdal:rasterize")
            first = QgsRasterLayer(norm_paths[0], "ref")
            ext = first.extent()
            px = first.rasterUnitsPerPixelX()
            mask = processing.run(rasterize, {
                "INPUT": constraint,
                "BURN": 0, "INIT": 1, "UNITS": 1,
                "WIDTH": px, "HEIGHT": px,
                "EXTENT": ext, "DATA_TYPE": 5,
                "OUTPUT": "TEMPORARY_OUTPUT"
            }, context=context, feedback=feedback,
               is_child_algorithm=True)["OUTPUT"]

            wlayer = QgsRasterLayer(weighted, "weighted")
            mlayer = QgsRasterLayer(mask, "mask")
            result = processing.run(calc, {
                "EXPRESSION": '"weighted@1" * "mask@1"',
                "LAYERS": [wlayer, mlayer],
                "OUTPUT": parameters[self.OUTPUT]
            }, context=context, feedback=feedback,
               is_child_algorithm=True)["OUTPUT"]
        else:
            result = weighted

        feedback.setProgress(100)
        return {self.OUTPUT: result}
```

> **호환성 메모 (중요)** —
> 래스터 계산기는 버전대별 알고리즘 ID·파라미터가 변해 온 대표 사례다.
> `find_alg` 폴백 + 배포 전 3.44/4.2 양쪽 실행 테스트가 필수이며,
> 파라미터 상세가 다르면 compat.py에 `run_raster_calc()` 래퍼를 만들어
> 버전 분기를 한 곳에 가둔다. (연습문제 3)

